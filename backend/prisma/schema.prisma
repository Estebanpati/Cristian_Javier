// ============================================================
//  laburo_db  |  Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  Catálogo: niveles académicos
// ------------------------------------------------------------
model NivelAcademico {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(50)

  personas Persona[]

  @@map("nivel_academico")
}

// ------------------------------------------------------------
//  Catálogo: niveles de responsabilidad
// ------------------------------------------------------------
model NivelResponsabilidad {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(60)

  personas Persona[]

  @@map("nivel_responsabilidad")
}

// ------------------------------------------------------------
//  Bloques / subgrupos
// ------------------------------------------------------------
model Bloque {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String?

  personas Persona[]

  @@map("bloque")
}

// ------------------------------------------------------------
//  Tabla principal: personas
// ------------------------------------------------------------
model Persona {
  id                     Int      @id @default(autoincrement())
  nombreCompleto         String   @db.VarChar(200)
  profesion              String?  @db.VarChar(150)
  idNivelAcademico       Int
  fechaNacimiento        DateTime @db.Date
  idBloque               Int?
  idNivelResponsabilidad Int
  pretensionSalarial     Decimal? @db.Decimal(12, 2)
  creadoEn               DateTime @default(now()) @db.Timestamptz()

  // Relaciones
  nivelAcademico       NivelAcademico       @relation(fields: [idNivelAcademico], references: [id])
  bloque               Bloque?              @relation(fields: [idBloque], references: [id])
  nivelResponsabilidad NivelResponsabilidad @relation(fields: [idNivelResponsabilidad], references: [id])

  @@index([idBloque],               name: "idx_persona_bloque")
  @@index([idNivelResponsabilidad], name: "idx_persona_responsabilidad")
  @@index([idNivelAcademico],       name: "idx_persona_nivel_academico")
  @@map("persona")
}
